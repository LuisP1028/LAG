\r\n    \"/v1/data/article/\": {\r\n      \"get\": {\r\n        \"tags\": [\r\n          \"data\"\r\n        ],\r\n        \"summary\": \"Retrieves all article fields that are not in a separate article endpoint. License agreement token required.\",\r\n        \"description\": \"Retrieves all article fields that are not in a separate article endpoint. The Article ID must be provided, and optionally, a version can be specified. If no version is specified, the most recent version will be returned. \u003cbr/\u003e\u003cbr/\u003eRequires a license agreement token. Obtain it by calling /v1/metadata/license-agreement. By retrieving the token, you agree to the terms outlined in the license agreement at that endpoint. The token is valid for one hour and must be included as a Bearer token in the Authorization header.\",\r\n        \"operationId\": \"getDataArticle\",\r\n        \"parameters\": [\r\n          {\r\n            \"$ref\": \"#/components/parameters/articleid\"\r\n          },\r\n          {\r\n            \"$ref\": \"#/components/parameters/ver\"\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"type\": \"object\",\r\n                  \"properties\": {\r\n"}}}
